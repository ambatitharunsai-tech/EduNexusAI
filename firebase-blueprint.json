{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated EduNexus AI user profile for optional Google Sign-In cloud sync.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the authenticated user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified Google account email."
        },
        "role": {
          "type": "string",
          "enum": ["advisor", "faculty", "student", "evaluator"],
          "maxLength": 32,
          "description": "Workspace role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent sync."
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "CloudIntervention": {
      "title": "CloudIntervention",
      "description": "Student support intervention synced to Firestore by an authenticated user.",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the staff member who logged the intervention."
        },
        "studentId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target student identifier."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Intervention title."
        },
        "interventionType": {
          "type": "string",
          "maxLength": 64,
          "description": "Category of support intervention."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"],
          "maxLength": 16,
          "description": "Support priority level."
        },
        "status": {
          "type": "string",
          "enum": ["planned", "in_progress", "under_review", "completed"],
          "maxLength": 32,
          "description": "Lifecycle status of the intervention."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Support notes and action plan."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "authorUid",
        "studentId",
        "title",
        "interventionType",
        "priority",
        "status",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "CopilotSession": {
      "title": "CopilotSession",
      "description": "Multi-turn Gemini AI Analytics Copilot conversation session.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user who owns this Copilot thread."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Summary title of the conversation."
        },
        "modelTier": {
          "type": "string",
          "enum": ["gemini-3.1-flash-lite", "gemini-3.8-flash", "gemini-4-argon"],
          "maxLength": 48,
          "description": "Selected Gemini model tier."
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 500,
          "description": "Preview of the most recent assistant response."
        },
        "messageCount": {
          "type": "number",
          "description": "Total number of messages in the thread."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp."
        }
      },
      "required": [
        "ownerUid",
        "title",
        "modelTier",
        "lastMessagePreview",
        "messageCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents keyed by Firebase Auth UID."
    },
    "/interventions/{interventionId}": {
      "schema": "CloudIntervention",
      "description": "Cloud-synced student support interventions owned by the creating user."
    },
    "/copilot_sessions/{sessionId}": {
      "schema": "CopilotSession",
      "description": "Saved multi-turn Gemini Copilot sessions owned by the authenticated user."
    }
  }
}
